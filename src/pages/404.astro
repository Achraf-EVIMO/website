---
import Base from '../layouts/Base.astro';
import { fr } from '../i18n/fr';
import { en } from '../i18n/en';
---
<Base t={fr} title={fr.notFound.title}>
  <section class="page-head" style="border:0;padding:120px 0">
    <div class="container" style="justify-items:start">
      <h1 class="display">{fr.notFound.title}</h1>
      <p class="lead">{fr.notFound.text} <span lang="en">{en.notFound.text}</span></p>
      <div class="btns">
        <a class="btn btn-primary" href="/">{fr.notFound.back}</a>
        <a class="btn" href="/en/" lang="en">{en.notFound.back}</a>
      </div>
    </div>
  </section>
</Base>

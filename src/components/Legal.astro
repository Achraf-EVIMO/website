---
import Base from '../layouts/Base.astro';
import { fr } from '../i18n/fr';

interface Props { title: string; updated: string }
const { title, updated } = Astro.props;
---
<Base t={fr} title={title} current="legal" alternate="/en/">
  <section class="page-head">
    <div class="container">
      <h1 class="display">{title}</h1>
      <p class="muted small">Dernière mise à jour : {updated}</p>
    </div>
  </section>
  <section class="section" style="padding-top:8px">
    <div class="container"><article class="prose"><slot /></article></div>
  </section>
</Base>

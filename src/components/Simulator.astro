---
// Simulateur d'économies (formules de l'ancien site).
// Modèle : 120 messages OCPP par point de charge et par jour ; 6 alertes par panne réelle avant regroupement.
import type { Dict } from '../i18n/fr';
interface Props { t: Dict }
const { t } = Astro.props;
const s = t.sim;
const o = t.simOut;
---
<div class="sim" data-lang={t.lang}>
  <div class="sim-in">
    <h2 class="sim-title">{s.title}</h2>
    <label class="rng"><span class="rng-top"><span>{s.inputs.fleet}</span><b data-out="fleet"></b></span><input type="range" name="fleet" min="100" max="10000" step="100" value="1200" /></label>
    <label class="rng"><span class="rng-top"><span>{s.inputs.rate}</span><b data-out="rate"></b></span><input type="range" name="rate" min="5" max="100" step="1" value="40" /></label>
    <label class="rng"><span class="rng-top"><span>{s.inputs.remote}</span><b data-out="remote"></b></span><input type="range" name="remote" min="0" max="90" step="5" value="60" /></label>
    <label class="rng"><span class="rng-top"><span>{s.inputs.cost}</span><b data-out="cost"></b></span><input type="range" name="cost" min="80" max="800" step="10" value="250" /></label>
    <p class="note" style="line-height:1.5">{s.model}</p>
  </div>
  <div class="sim-out">
    <div class="sim-grid">
      <div><span>{o.signals}</span><b class="num" data-out="signals"></b></div>
      <div><span>{o.incidents}</span><b class="num" data-out="incidents"></b></div>
      <div><span>{o.remote}</span><b class="num" data-out="avoided"></b></div>
      <div><span>{o.absorbed}</span><b class="num" data-out="absorbed"></b></div>
    </div>
    <div class="sim-total">
      <span>{o.year}</span>
      <b class="num" data-out="savedYear"></b>
      <span class="sim-month"><span data-out="saved"></span> · {s.saved.toLowerCase()}</span>
      <a class="btn btn-white" href={t.routes.audit}>{s.cta}</a>
    </div>
  </div>
</div>

<style>
  .sim { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); border-radius: 24px; overflow: hidden; border: 1px solid var(--line); box-shadow: 0 30px 80px -50px rgba(2, 20, 46, .35); }
  .sim-in { background: #fff; padding: 40px; display: flex; flex-direction: column; gap: 26px; color: var(--ink-2); min-width: 0; }
  .sim-title { color: var(--ink); font-size: 32px; letter-spacing: -0.03em; line-height: 1.1; font-weight: 750; }
  .sim-out { background: var(--accent); color: #fff; padding: 40px; display: flex; flex-direction: column; justify-content: space-between; gap: 32px; min-width: 0; }
  .rng { display: grid; gap: 10px; cursor: pointer; }
  .rng-top { display: flex; justify-content: space-between; gap: 12px; font-size: 15px; }
  .rng-top b { color: var(--ink); font-weight: 700; white-space: nowrap; font-variant-numeric: tabular-nums; }
  input[type=range] { -webkit-appearance: none; appearance: none; width: 100%; height: 6px; border-radius: 3px; background: linear-gradient(var(--accent), var(--accent)) 0 / var(--p, 50%) 100% no-repeat, var(--line-2); }
  input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 22px; height: 22px; border-radius: 50%; background: #fff; border: 2px solid var(--accent); box-shadow: 0 0 0 4px rgba(0, 89, 255, .18); cursor: grab; }
  input[type=range]::-moz-range-thumb { width: 18px; height: 18px; border-radius: 50%; background: #fff; border: 2px solid var(--accent); box-shadow: 0 0 0 4px rgba(0, 89, 255, .18); }
  .sim-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
  .sim-grid > div { display: grid; gap: 2px; min-width: 0; }
  .sim-grid span { font-size: 13.5px; opacity: .85; }
  .sim-grid b { font-size: clamp(30px, 3.4vw, 40px); font-weight: 750; letter-spacing: -0.03em; line-height: 1.15; }
  .sim-total { display: grid; gap: 6px; justify-items: start; }
  .sim-total > span:first-child { font-size: 15px; opacity: .85; }
  .sim-total b { font-size: clamp(46px, 6.4vw, 92px); font-weight: 800; letter-spacing: -0.05em; line-height: 1; }
  .sim-month { font-size: 14.5px; opacity: .85; margin-bottom: 18px; }
  @media (max-width: 900px) { .sim { grid-template-columns: minmax(0, 1fr); } .sim-in, .sim-out { padding: 26px; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.sim').forEach((root) => {
    const fr = root.dataset.lang === 'fr';
    const loc = fr ? 'fr-FR' : 'en-GB';
    const clean = (s: string) => s.replace(/ /g, ' ');
    const n = (v: number) => clean(Math.round(v).toLocaleString(loc));
    const dec = (v: number, d: number) => clean(v.toLocaleString(loc, { minimumFractionDigits: d, maximumFractionDigits: d }));
    const money = (v: number) => (fr ? n(v) + ' €' : '€' + n(v));
    const inputs = root.querySelectorAll<HTMLInputElement>('input[type=range]');
    const out = (k: string, v: string) => root.querySelectorAll(`[data-out="${k}"]`).forEach((e) => (e.textContent = v));
    const update = () => {
      const v: Record<string, number> = {};
      inputs.forEach((i) => {
        v[i.name] = Number(i.value);
        i.style.setProperty('--p', ((Number(i.value) - Number(i.min)) / (Number(i.max) - Number(i.min))) * 100 + '%');
      });
      const faults = Math.round(v.fleet * (v.rate / 100));
      const alerts = faults * 6;
      const signals = v.fleet * 120 * 30;
      const human = Math.round(faults * (1 - v.remote / 100));
      const avoided = faults - human;
      const surviving = alerts > 0 ? (human / alerts) * 100 : 0;
      out('fleet', n(v.fleet));
      out('rate', dec(v.rate / 100, 2));
      out('remote', v.remote + ' %');
      out('cost', money(v.cost));
      out('signals', signals >= 1e6 ? dec(signals / 1e6, 1) + ' M' : n(signals));
      out('incidents', n(faults));
      out('avoided', n(avoided));
      out('absorbed', dec(100 - surviving, 0) + ' %');
      out('saved', money(avoided * v.cost));
      out('savedYear', money(avoided * v.cost * 12));
    };
    inputs.forEach((i) => i.addEventListener('input', update));
    update();
  });
</script>

---
// Simulateur d'économies, repris de l'ancien site.
// Modèle : 120 messages OCPP par point de charge et par jour ; 6 alertes par panne réelle avant regroupement.
import type { Dict } from '../i18n/fr';
interface Props { t: Dict }
const { t } = Astro.props;
const s = t.sim;
---
<div class="sim card" data-lang={t.lang}>
  <div class="sim-in">
    <div class="sim-inputs">
      <label class="rng">
        <span class="rng-top"><span>{s.inputs.fleet}</span><b data-out="fleet"></b></span>
        <input type="range" name="fleet" min="100" max="10000" step="100" value="1200" />
      </label>
      <label class="rng">
        <span class="rng-top"><span>{s.inputs.rate}</span><b data-out="rate"></b></span>
        <input type="range" name="rate" min="5" max="100" step="1" value="40" />
      </label>
      <label class="rng">
        <span class="rng-top"><span>{s.inputs.remote}</span><b data-out="remote"></b></span>
        <input type="range" name="remote" min="0" max="90" step="5" value="60" />
      </label>
      <label class="rng">
        <span class="rng-top"><span>{s.inputs.cost}</span><b data-out="cost"></b></span>
        <input type="range" name="cost" min="80" max="800" step="10" value="250" />
      </label>
      <p class="illustrative" style="font-size:12.5px;line-height:1.5">{s.model}</p>
    </div>

    <div class="sim-out">
      <p class="label" style="margin-bottom:12px">{s.outTitle}</p>
      <div class="sim-grid">
        {(['signals', 'alerts', 'incidents', 'human'] as const).map((k) => (
          <div class="sim-cell">
            <span class="sim-k">{s.out[k][0]}</span>
            <b class="sim-v num" data-out={k}></b>
            <span class="sim-h">{s.out[k][1]}</span>
          </div>
        ))}
      </div>

      <div class="sim-abs">
        <div class="rng-top"><span>{s.absorbedTitle}</span><b><span data-out="absorbed"></span> <span class="muted" style="font-weight:500">{s.absorbed}</span></b></div>
        <span class="bar" style="height:10px"><span data-bar="absorbed"></span></span>
        <span class="sim-h"><span data-out="surviving"></span> {s.escalated}</span>
      </div>

      <div class="sim-total">
        <div><span class="sim-k">{s.avoided}</span><b class="num" data-out="avoided"></b></div>
        <div><span class="sim-k">{s.saved}</span><b class="num accent" data-out="saved"></b><span class="sim-h"><span data-out="savedYear"></span> {s.savedYear}</span></div>
        <a class="btn btn-primary" href={t.routes.audit}>{s.cta}</a>
      </div>
    </div>
  </div>
</div>

<style>
  .sim { padding: 0; overflow: hidden; }
  .sim-in { display: grid; grid-template-columns: 0.9fr 1.1fr; }
  .sim-in > *, .sim-grid > *, .sim-total > * { min-width: 0; }
  .sim-abs .rng-top { flex-wrap: wrap; }
  .sim-abs .rng-top b { white-space: normal; }
  .sim-inputs { padding: 32px; display: grid; gap: 26px; align-content: start; border-right: 1px solid var(--line); background: var(--bg-subtle); }
  .sim-out { padding: 32px; display: grid; gap: 22px; align-content: start; }
  .rng { display: grid; gap: 10px; cursor: pointer; }
  .rng-top { display: flex; justify-content: space-between; gap: 12px; font-size: 14.5px; color: var(--ink-2); }
  .rng-top b { color: var(--ink); font-weight: 650; font-variant-numeric: tabular-nums; white-space: nowrap; }
  input[type=range] { -webkit-appearance: none; appearance: none; width: 100%; height: 6px; border-radius: 3px; background: linear-gradient(var(--accent), var(--accent)) 0/var(--p, 50%) 100% no-repeat, var(--line); outline-offset: 6px; }
  input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 20px; height: 20px; border-radius: 50%; background: #fff; border: 2px solid var(--accent); box-shadow: 0 0 0 4px var(--glow); }
  input[type=range]::-moz-range-thumb { width: 18px; height: 18px; border-radius: 50%; background: #fff; border: 2px solid var(--accent); box-shadow: 0 0 0 4px var(--glow); }
  .sim-grid { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--line); border-radius: var(--radius-tile); overflow: hidden; }
  .sim-cell { padding: 16px; display: grid; gap: 4px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .sim-cell:nth-child(2n) { border-right: 0; }
  .sim-cell:nth-last-child(-n+2) { border-bottom: 0; }
  .sim-k { font-size: 13px; color: var(--muted); }
  .sim-v { font-size: 28px; color: var(--ink); letter-spacing: -0.02em; font-weight: 650; line-height: 1.15; }
  .sim-h { font-size: 12.5px; color: var(--muted); }
  .sim-abs { display: grid; gap: 8px; }
  .sim-abs .rng-top { font-size: 14px; }
  .sim-total { display: grid; grid-template-columns: 1fr 1fr auto; gap: 16px; align-items: end; padding-top: 20px; border-top: 1px solid var(--line); }
  .sim-total > div { display: grid; gap: 2px; }
  .sim-total b { font-size: 30px; font-weight: 650; letter-spacing: -0.02em; color: var(--ink); line-height: 1.15; }
  .sim-total b.accent { color: var(--accent-text); }
  @media (max-width: 1000px) {
    .sim-in { grid-template-columns: 1fr; }
    .sim-inputs { border-right: 0; border-bottom: 1px solid var(--line); }
    .sim-total { grid-template-columns: 1fr 1fr; }
    .sim-total .btn { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) {
    .sim-inputs, .sim-out { padding: 22px; }
    .sim-v { font-size: 22px; }
    .sim-cell { padding: 12px; }
    .sim-k { font-size: 12.5px; }
    .sim-total b { font-size: 24px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.sim').forEach((root) => {
    const fr = root.dataset.lang === 'fr';
    const loc = fr ? 'fr-FR' : 'en-GB';
    const clean = (s: string) => s.replace(/ /g, ' ');
    const n = (v: number) => clean(Math.round(v).toLocaleString(loc));
    const dec = (v: number, d: number) => clean(v.toLocaleString(loc, { minimumFractionDigits: d, maximumFractionDigits: d }));
    const money = (v: number) => (fr ? n(v) + ' €' : '€' + n(v));
    const inputs = root.querySelectorAll<HTMLInputElement>('input[type=range]');
    const out = (k: string, v: string) => root.querySelectorAll(`[data-out="${k}"]`).forEach((e) => (e.textContent = v));

    const update = () => {
      const v: Record<string, number> = {};
      inputs.forEach((i) => {
        v[i.name] = Number(i.value);
        const p = ((Number(i.value) - Number(i.min)) / (Number(i.max) - Number(i.min))) * 100;
        i.style.setProperty('--p', p + '%');
      });
      const faultRate = v.rate / 100;
      const faults = Math.round(v.fleet * faultRate);
      const alerts = faults * 6;
      const signals = v.fleet * 120 * 30;
      const human = Math.round(faults * (1 - v.remote / 100));
      const avoided = faults - human;
      const surviving = alerts > 0 ? (human / alerts) * 100 : 0;

      out('fleet', n(v.fleet));
      out('rate', dec(faultRate, 2));
      out('remote', v.remote + ' %');
      out('cost', money(v.cost));
      out('signals', signals >= 1e6 ? dec(signals / 1e6, 1) + ' M' : n(signals));
      out('alerts', n(alerts));
      out('incidents', n(faults));
      out('human', n(human));
      out('absorbed', dec(100 - surviving, 1) + ' %');
      out('surviving', dec(surviving, 1) + ' %');
      out('avoided', n(avoided));
      out('saved', money(avoided * v.cost));
      out('savedYear', money(avoided * v.cost * 12));
      const bar = root.querySelector<HTMLElement>('[data-bar="absorbed"]');
      if (bar) bar.style.width = Math.max(0, Math.min(100, 100 - surviving)) + '%';
    };
    inputs.forEach((i) => i.addEventListener('input', update));
    update();
  });
</script>

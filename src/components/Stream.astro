---
// « Deux cent dix-huit messages. Un seul incident. » : la seule bande sombre du site.
import type { Dict } from '../i18n/fr';
interface Props { t: Dict }
const { t } = Astro.props;
const s = t.stream;
const f = t.flux;

const raw = [
  ['10:42:01', 'FR-AUL-N', 'CP-014', 'StatusNotification', 'Faulted', 'GroundFailure', 'g'],
  ['10:42:01', 'FR-AUL-N', 'CP-014', 'ConnectionLost', '-', 'backhaul', 'g'],
  ['10:42:02', 'FR-AUL-N', 'CP-015', 'ConnectionLost', '-', 'backhaul', 'g'],
  ['10:42:03', 'FR-VIT-P', 'CP-002', 'StatusNotification', 'SuspendedEV', '-', ''],
  ['10:42:03', 'FR-AUL-N', 'CP-017', 'ConnectionLost', '-', 'backhaul', 'g'],
  ['10:42:04', 'FR-CER-S', 'CP-009', 'StopTransaction', 'Reason=Other', 'sess 8814', ''],
  ['10:42:05', 'FR-VIT-P', 'CP-002', 'StatusNotification', 'Faulted', 'ConnectorLockFailure', 'r'],
  ['10:42:05', 'FR-AUL-N', 'CP-019', 'ConnectionLost', '-', 'backhaul', 'g'],
  ['10:42:06', 'FR-CER-S', 'CP-011', 'MeterValues', '21.4 kW', 'drift −4%', ''],
  ['10:42:07', 'FR-AUL-N', 'CP-021', 'ConnectionLost', '-', 'backhaul', 'g'],
  ['10:42:07', 'FR-BAG-E', 'CP-003', 'Heartbeat', 'ok', '-', ''],
  ['10:42:08', 'FR-CER-S', 'CP-009', 'StartTransaction', 'failed', 'retry 2', 'r'],
  ['10:42:09', 'FR-AUL-N', 'CP-023', 'ConnectionLost', '-', 'backhaul', 'g'],
  ['10:42:10', 'FR-VIT-P', 'CP-002', 'ChangeAvailability', 'rejected', '-', ''],
  ['10:42:10', 'FR-AUL-N', 'CP-025', 'ConnectionLost', '-', 'backhaul', 'g'],
];
const line = (l: string[]) => `${l[0]}  ${l[1]}  ${l[2]}  ${l[3].padEnd(19)} ${l[4].padEnd(13)} ${l[5]}`;
const rows = s.rows;
---
<section class="night section" id="flux">
  <div class="container">
    <h2 class="h2" style="max-width:860px">{f.title}</h2>
    <p class="lead" style="margin-top:20px">{f.lead}</p>
    <div class="flux">
      <div class="logs" aria-hidden="true">
        <div class="logs-track">
          {[0, 1].map(() => raw.map((l) => <div class={l[6]}>{line(l)}</div>))}
        </div>
        <div class="logs-sweep"></div>
      </div>
      <article class="inc">
        <div class="inc-top"><span>{s.incidentHead} · {s.id}</span><span class="inc-prio">{s.priority}</span></div>
        <h3>{s.title}</h3>
        <dl>
          <dt>{rows[0][0]}</dt><dd>{rows[0][1]}</dd>
          <dt>{rows[2][0]}</dt><dd>{rows[2][1]}</dd>
          <dt>{f.action}</dt><dd>{f.actionValue}</dd>
        </dl>
        <div class="conf"><span>{s.confidence}</span><span class="bar"><span style="width:94%"></span></span><span class="num">0.94</span></div>
      </article>
    </div>
    <p class="flux-note">{s.note}</p>
  </div>
</section>

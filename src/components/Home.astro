---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import NetMap from './NetMap.astro';
import Stream from './Stream.astro';
import Simulator from './Simulator.astro';
import type { Dict } from '../i18n/fr';

interface Props { t: Dict }
const { t } = Astro.props;
const fr = t.lang === 'fr';
const titleParts = t.hero.title.split(fr ? ' du premier coup' : ' the first time');
const partners = [
  { name: 'SIGEIF', logo: '/partners/sigeif.png', role: t.partners.roles.SIGEIF },
  { name: 'SDEM50', logo: '/partners/sdem50.png', role: t.partners.roles.SDEM50 },
  { name: 'ANYOS', logo: '/partners/anyos.png', role: t.partners.roles.ANYOS },
];
---
<Base t={t} current="home" alternate={fr ? '/en/' : '/'}>
  <!-- Ouverture -->
  <section class="hero">
    <div class="container">
      <h1 class="display enter" style="max-width:1150px">
        {titleParts[0]}<span class="accent">{fr ? ' du premier coup' : ' the first time'}</span>{titleParts[1] ?? ''}
      </h1>
      <div class="hero-row enter-2">
        <p class="lead">{t.hero.lead}</p>
        <div class="btns">
          <a class="btn btn-primary" href={t.routes.audit}>{t.hero.primary}</a>
          <a class="btn" href="#trajet">{t.hero.secondary}</a>
        </div>
      </div>
    </div>
    <div class="container-wide"><NetMap t={t} /></div>
  </section>

  <!-- Références -->
  <section class="partners">
    <div class="container-wide partners-in">
      <div style="display:grid;gap:10px">
        <h2>{t.partners.title}</h2>
        <p class="muted">{t.partners.note}</p>
      </div>
      <div class="logos">
        {partners.map((p) => (
          <div class="logo-card">
            <img src={p.logo} alt={p.name} loading="lazy" />
            <span>{p.role}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Le constat -->
  <section class="band-white section" id="constat">
    <div class="container">
      <h2 class="h2" style="max-width:900px">{t.problem.title}</h2>
      <div class="stats">
        {t.problem.items.map((it) => (
          <div class="stat">
            <span class="stat-big">{it.stat}</span>
            <h3>{it.title}</h3>
            <p>{it.text}</p>
          </div>
        ))}
      </div>
      <blockquote class="quote">
        <p>{t.problem.quote}</p>
        <footer>{t.problem.quoteBy}</footer>
      </blockquote>
    </div>
  </section>

  <!-- Le flux (seule bande sombre) -->
  <Stream t={t} />

  <!-- Le trajet d'une panne -->
  <section class="section" id="trajet">
    <div class="container">
      <h2 class="h2" style="max-width:820px">{t.how.title}</h2>
      <div class="route" aria-hidden="true">
        <span class="route-line"></span>
        <span class="route-fill"></span>
        <span class="route-stop" style="left:0%">1</span>
        <span class="route-stop" style="left:50%">2</span>
        <span class="route-stop last" style="left:100%">3</span>
        <span class="route-runner"></span>
      </div>
      <div class="route-steps">
        {t.route.steps.map((s) => (
          <div><h3>{s.title}</h3><p>{s.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Produit -->
  <section class="band-white section" id="produit">
    <div class="container">
      <h2 class="h2" style="max-width:820px">{t.product.title}</h2>
      <p class="lead" style="margin-top:20px">{t.product.lead}</p>
      <div class="two">
        {[t.product.proxy, t.product.one].map((p) => (
          <div class="panel">
            <span class="tag">{p.tag}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
            <ul class="ticks">{p.items.map((x) => <li><Icon name="check" />{x}</li>)}</ul>
          </div>
        ))}
      </div>
      <div class="facts-line">{t.product.foot.map((x) => <span><Icon name="check" />{x}</span>)}</div>
    </div>
  </section>

  <!-- Pour qui -->
  <section class="section" id="pour-qui">
    <div class="container">
      <h2 class="h2" style="max-width:820px">{t.who.title}</h2>
      <div class="three">
        {t.who.items.map((w) => (
          <div class={`panel who${w.primary ? ' primary' : ''}`}>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
            <ul>{w.points.map((p) => <li>{p}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Simulateur -->
  <section class="section" id="simulateur" style="padding-top:0">
    <div class="container"><Simulator t={t} /></div>
  </section>

  <!-- Sécurité -->
  <section class="band-white section" id="securite">
    <div class="container">
      <h2 class="h2" style="max-width:820px">{t.security.title}</h2>
      <div class="rows">
        {t.security.items.map((s) => (<div><h3>{s.title}</h3><p>{s.text}</p></div>))}
      </div>
    </div>
  </section>

  <!-- Appel final -->
  <section class="section" id="audit">
    <div class="container">
      <div class="cta-card">
        <h2 class="h2">{t.cta.title}</h2>
        <div class="cta-side">
          <p>{t.cta.text}</p>
          <a class="btn btn-white" href={t.routes.audit}>{t.cta.button}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

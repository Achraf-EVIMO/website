---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { getCollection } from 'astro:content';
import { site } from '../site.config';
import type { Dict } from '../i18n/fr';

interface Props { t: Dict }
const { t } = Astro.props;
const c = t.careers;
const fr = t.lang === 'fr';
const jobs = (await getCollection('jobs', ({ data }) => data.published)).sort((a, b) => a.data.order - b.data.order);
---
<Base t={t} title={c.title} description={c.lead} current="careers" alternate={fr ? '/en/careers/' : '/nous-rejoindre/'}>
  <section class="page-head">
    <div class="container">
      <span class="eyebrow"><span class="dot"></span>{c.title}</span>
      <h1 class="h1" style="font-size:clamp(34px,4.6vw,52px);max-width:820px">{fr ? 'Construisez l\'outil qui fait marcher les bornes de recharge.' : 'Build the tool that keeps charging stations working.'}</h1>
      <p class="lead">{c.lead}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" style="margin-bottom:28px">
        <h2 class="h2" style="font-size:28px">{c.openTitle} <span class="muted num" style="font-weight:500">({jobs.length})</span></h2>
      </div>
      <div class="jobs">
        {jobs.length === 0 && <p class="empty">{c.none}</p>}
        {jobs.map((j) => (
          <a class="job" href={`/nous-rejoindre/${j.id}/`}>
            <div style="display:grid;gap:6px">
              <h3>{j.data.title}</h3>
              <div class="meta">
                <span>{j.data.location}</span>
                <span>{j.data.type}</span>
                {j.data.duration && <span>{j.data.duration}</span>}
                {j.data.start && <span>{j.data.start}</span>}
                {!fr && j.data.lang === 'fr' && <span class="tag">{c.inFrench}</span>}
              </div>
            </div>
            <span class="go">{c.see}<Icon name="arrow" /></span>
          </a>
        ))}
      </div>
      <p class="muted" style="margin-top:20px;font-size:15px">
        {c.spontaneous} <a class="link" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" style="margin-bottom:28px">
        <h2 class="h2" style="font-size:28px">{c.valuesTitle}</h2>
      </div>
      <div class="values">
        {c.values.map((v) => (
          <div class="card"><h3 class="h3">{v.title}</h3><p>{v.text}</p></div>
        ))}
      </div>
    </div>
  </section>
</Base>

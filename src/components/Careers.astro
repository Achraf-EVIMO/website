---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { getCollection } from 'astro:content';
import { site } from '../site.config';
import type { Dict } from '../i18n/fr';

interface Props { t: Dict }
const { t } = Astro.props;
const c = t.careers;
const fr = t.lang === 'fr';
const jobs = (await getCollection('jobs', ({ data }) => data.published)).sort((a, b) => a.data.order - b.data.order);
---
<Base t={t} title={c.title} description={c.lead} current="careers" alternate={fr ? '/en/careers/' : '/nous-rejoindre/'}>
  <section class="page-head">
    <div class="container">
      <h1 class="display">{fr ? 'Construisez l\'outil qui fait marcher les bornes de recharge.' : 'Build the tool that keeps charging stations working.'}</h1>
      <p class="lead">{c.lead}</p>
    </div>
  </section>

  <section class="section" style="padding-top:8px">
    <div class="container">
      <div style="margin-bottom:28px">
        <h2 class="h2" style="font-size:clamp(28px,3vw,40px)">{c.openTitle} <span class="muted num" style="font-weight:500">({jobs.length})</span></h2>
      </div>
      <div class="jobs">
        {jobs.length === 0 && <p class="empty">{c.none}</p>}
        {jobs.map((j) => (
          <a class="job" href={`/nous-rejoindre/${j.id}/`}>
            <div style="display:grid;gap:6px">
              <h3>{j.data.title}</h3>
              <div class="meta">
                <span>{j.data.location}</span>
                <span>{j.data.type}</span>
                {j.data.duration && <span>{j.data.duration}</span>}
                {j.data.start && <span>{j.data.start}</span>}
                {j.data.remote && <span>{j.data.remote}</span>}
                {!fr && j.data.lang === 'fr' && <span class="pill">{c.inFrench}</span>}
              </div>
            </div>
            <span class="go">{c.see}<Icon name="arrow" /></span>
          </a>
        ))}
      </div>
      <div class="job" style="margin-top:14px;background:transparent;border-style:dashed">
        <p class="muted" style="font-size:16px">{c.spontaneous}</p>
        <a class="btn btn-sm" href={site.applyTallyUrl} target="_blank" rel="noopener">{c.applyTally}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div style="margin-bottom:28px">
        <h2 class="h2" style="font-size:clamp(28px,3vw,40px)">{c.valuesTitle}</h2>
      </div>
      <div class="three" style="margin-top:0">
        {c.values.map((v) => (
          <div class="panel"><h3 style="font-size:22px">{v.title}</h3><p>{v.text}</p></div>
        ))}
      </div>
    </div>
  </section>
</Base>

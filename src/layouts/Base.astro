---
import '@fontsource-variable/geist';
import '@fontsource/geist-mono/400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Dict } from '../i18n/fr';

interface Props {
  t: Dict;
  title?: string;
  description?: string;
  /** Adresse de la même page dans l'autre langue (pour le bouton FR/EN). */
  alternate?: string;
  current?: 'home' | 'audit' | 'careers' | 'legal';
}

const { t, title, description, alternate, current } = Astro.props;
const pageTitle = title ? `${title} · EVIMO` : t.meta.title;
const desc = description ?? t.meta.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
const other = alternate ?? (t.lang === 'fr' ? '/en/' : '/');
---
<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={t.lang === 'fr' ? 'en' : 'fr'} href={new URL(other, Astro.site)} />
    <link rel="alternate" hreflang={t.lang} href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EVIMO" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.lang === 'fr' ? 'fr_FR' : 'en_GB'} />
  </head>
  <body>
    <a class="skip" href="#main">{t.lang === 'fr' ? 'Aller au contenu' : 'Skip to content'}</a>
    <Header t={t} alternate={other} current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer t={t} />
  </body>
</html>
